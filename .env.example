# Credenziali Telegram (da my.telegram.org)
API_ID=1234567
API_HASH=your_api_hash_here

# Percorso/nome del file di sessione (.session) per evitare database locked su cartelle condivise
# Esempio su Linux: SESSION_PATH=/home/ersi/my_video_downloader_bot.session
SESSION_NAME=my_video_downloader_bot
SESSION_PATH=

# Canale di destinazione (usare UNO dei due)
CHANNEL_ID=-1001234567890
# CHANNEL_USERNAME=@tuo_canale

# Owner (il TUO ID utente Telegram principale)
OWNER_ID=123456789

# Download
DOWNLOAD_DIR=downloads/
MAX_RETRIES=3
MAX_FILE_SIZE_GB=2
PROGRESS_UPDATE_INTERVAL=2

# Cookie YouTube (RISOLVE "Sign in to confirm you're not a bot")
# Imposta il browser dove sei loggato su YouTube:
#   chrome | edge | firefox | brave | chromium | opera | vivaldi | whale
COOKIES_FROM_BROWSER=chrome

# Cookie da file (esportati con estensione browser come "Get cookies.txt LOCALLY")
COOKIES_FILE=data/cookies.txt

# Forza connessione IPv4 (consigliato su Linux per evitare blocchi YouTube/Cloudflare)
FORCE_IPV4=true

# Usa downloader multi-thread aria2c (consigliato su CPU deboli per download diretti HTTP)
USE_ARIA2=true

# Numero di frammenti scaricati in parallelo per HLS/DASH (es. Pornhub, Youtube)
# Default 16: valori alti = piu veloce, ma piu CPU/banda per connessione
CONCURRENT_FRAGMENTS=16

# Impersonamento TLS browser via curl_cffi (evita blocchi Cloudflare/Akamai 403)
# Valori: chrome | safari | firefox | edge ... oppure "none" per disattivare
IMPERSONATE=chrome

# Dimensione chunk HTTP del downloader nativo (vuoto = auto)
HTTP_CHUNK_SIZE=

# Rilevatore partenza lenta: se il download e' sotto SLOW_START_MIN_KB per
# SLOW_START_GRACE secondi, riparte con piu connessioni concorrenti
SLOW_START_GRACE=8
SLOW_START_MIN_KB=250
